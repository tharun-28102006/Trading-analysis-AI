# Copy variables into the current PowerShell session or your local environment.
# The application does not load a .env file automatically.
NIVESH_DATA_DIR=D:\Trading AI\.nivesh-data
NIVESH_HOST=127.0.0.1
NIVESH_PORT=8000
# Set only if you configure a caller that exposes the local API beyond localhost.
NIVESH_API_TOKEN=

# MoSPI CPI current series is publicly accessible; no credentials are required.
# CPI is macro context only, not equity or NIFTY data.

# Tej Bazaar NSE/BSE historical Parquet root; defaults to this project's data/out folder.
NIVESH_TEJ_DATA_DIR=D:\Trading AI\data\out
NIVESH_TEJ_OVERLAP_DAYS=7
NIVESH_TEJ_TIMEOUT_SECONDS=8
# Automatic free TejHQ keyless NSE/BSE EOD snapshot refresh; app must be running.
# The source snapshots are merged into this directory; immutable releases are published after validation.
NIVESH_DAILY_REFRESH_ENABLED=1
NIVESH_DAILY_REFRESH_HOUR=21
NIVESH_DAILY_REFRESH_MINUTE=30
# Existing eligible models are not retrained by run-all unless opted in.
NIVESH_AUTO_RETRAIN=0
